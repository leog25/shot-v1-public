# =============================================================
# Callable agent — local environment
# Gitignored. Template lives in .env.example.
# Blank values are yours to fill; filled values were derived from
# your gcloud config or are deliberate defaults.
# =============================================================


# ── GCP ──────────────────────────────────────────────────────
# ADC is already configured and working, so there is no key file
# and no service-account JSON here. On the GCE VM, the attached
# service account covers the same ground. These are just config.
GCP_PROJECT_ID=
GCP_REGION=
GCP_ZONE=
# The VM that runs tiers 1 and 2, and the Secret Manager secret holding this
# file. ops/deploy.sh and ops/restart.sh read both and refuse without them.
GCP_VM=
GCP_ENV_SECRET=

# Cloud Tasks queue — the independent second firing path for
# callbacks, so a supervisor restart can't lose a timer.
#   gcloud tasks queues create callbacks --location=<region>
CLOUD_TASKS_QUEUE=callbacks
CLOUD_TASKS_LOCATION=


# ── Tier 2 · supervisor ──────────────────────────────────────
# Postgres backs both the task registry and DBOS durable state.
# Local dev: the shot-pg container from the README.
DATABASE_URL=postgresql://postgres:shot@localhost:5433/shot

# Public HTTPS base for the webhook receivers. Anthropic and
# LiveKit both require a publicly resolvable HTTPS endpoint, and
# Anthropic auto-disables an endpoint that returns any 3xx.
# In dev use a tunnel (cloudflared / ngrok); in prod, the VM.
PUBLIC_BASE_URL=


# ── Tier 1 · voice ───────────────────────────────────────────
# LiveKit Cloud → Settings → Keys.
# Ship plan or higher: the free Build plan scales agents to zero,
# adding 10–20 s before the agent joins — a dead line on the ring.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI. Check your usage tier: Tier 1 caps at 40k TPM and a
# realtime turn late in a call can request 5k+ tokens. That
# ceiling, not concurrency, is what bites.
OPENAI_API_KEY=

# Pin explicitly — the LiveKit plugin still defaults to the bare
# `gpt-realtime`, which is deprecated (removed 2027-01-20).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# `low` is the staff-confirmed default; pinned so a server-side
# change can't move us. Do NOT use `minimal` — it saves 240 ms and
# costs 7.7 pts of agentic performance.
OPENAI_REASONING_EFFORT=low

# AMD's streaming STT; see livekit/agents#6996.
DEEPGRAM_API_KEY=


# ── Telephony ────────────────────────────────────────────────
# Twilio Console → Account → API keys & tokens → Create API key.
# Use an API key pair, NOT the account Auth Token — revocable on
# its own without rotating everything else.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Your purchased number, E.164 (+1...). Buy it early and test-call
# it — numbers arrive carrying the previous owner's spam labels.
TWILIO_PHONE_NUMBER=

# The only number allowed to call in, and the one we call back.
# Also set this on the LiveKit inbound trunk (allowed_numbers) and
# the dispatch rule (inbound_numbers) — two independent layers.
OWNER_PHONE_NUMBER=

# Who Shot works for, by name: the persona, the greeting, the worker's
# system prompt. Unset reads as "the owner" -- ops/deploy.sh refuses a
# Secret Manager copy without it, because nothing else would notice.
OWNER_NAME=

# IANA zone for the owner. Drives the time-of-day greeting ("Good
# morning") AND the echo_time tool -- both read this through
# shot_core.clock, so they cannot drift. It was hardcoded inside
# echo_time. e.g. America/New_York
# A bad value here does NOT fail startup: now_local() falls back to
# UTC with a warning. A wrong greeting is not worth taking the phone
# number down for, unlike a bad OWNER_PHONE_NUMBER.
OWNER_TIMEZONE=

# Elastic SIP Trunk. Termination URI ends in pstn.twilio.com; the
# credential-list username/password you create in the Twilio
# console are what LiveKit's CreateSIPOutboundTrunk authenticates
# with. Outbound only works through Twilio — LiveKit's own phone
# numbers are inbound-only today.
TWILIO_TRUNK_TERMINATION_URI=
TWILIO_TRUNK_AUTH_USERNAME=
TWILIO_TRUNK_AUTH_PASSWORD=

# Filled in after creating them via the LiveKit SIP API.
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=

# Ring window. Cap is 80 s, but a US mobile rolls to voicemail at
# ~20–25 s, and the Python SDK silently pins 30 s when
# wait_until_answered=True. Set it consciously.
RINGING_TIMEOUT_SECONDS=20

# Answering-machine detection. These MIRROR shot_core/budget.py and
# test_budget.py fails if they drift -- change both, deliberately.
# They must nest: no_speech < detect < wait, enforced by a validator
# at import so a bad value fails on startup and not on a live call.
# NOTE .env OUTRANKS the process environment (settings_customise_sources),
# so `export AMD_NO_SPEECH_SECONDS=2` LOSES to a line here. Edit here.
#
# no_speech is a give-up-if-silent timer: once any speech starts, the
# detect window governs instead. It is also dead air, because AMD holds
# speech-playout authorization for the whole of its run -- so a person
# who answers and politely waits for the agent hears exactly this much
# silence first. 6.0 -> 3.0; lower costs detection only for a box that
# stays quiet through its own opening. MANUAL_E2E M3 is the test.
AMD_DETECTION_TIMEOUT_SECONDS=8.0
AMD_NO_SPEECH_SECONDS=3.0
# Outer belt for livekit/agents#6996 (AMD stalls 17-20s on ~7% of
# answered calls). Summed into budget.worst_case_call_s(): at 9.0 there
# are 56s of headroom against the 240s rendezvous, and 12.0 is the
# ceiling before a slow-but-healthy call records as `no_report`.
AMD_WAIT_SECONDS=9.0


# ── Tier 3 · worker agent ────────────────────────────────────
# IMPORTANT: create a DEDICATED Anthropic workspace and generate
# this key inside it. Webhooks are workspace-scoped — a key in
# workspace A with an endpoint registered in workspace B receives
# zero deliveries, silently. This is the #1 setup failure.
ANTHROPIC_API_KEY=

# Console → Manage → Webhooks. Shown once at creation.
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# Filled in after creating them (agent, environment, memory store,
# vault are all created once and referenced by ID thereafter).
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_MEMORY_STORE_ID=
ANTHROPIC_VAULT_ID=

# Hard ceiling per worker session, US cents as a string in the API.
# Stops a runaway browser loop at budget_reached instead of $200.
# 2500 ($25) was larger than the whole account balance, so the guard
# could never fire. About one real browsing task.
SESSION_BUDGET_CENTS=300


# ── Browser ──────────────────────────────────────────────────
# NOTE: the worker agent should NOT read this from here. Register
# it in the Anthropic vault as a static_bearer credential keyed by
# the Browserbase MCP server URL — then the sandbox holds only an
# opaque placeholder and the agent cannot leak the key even under
# prompt injection. Keep it here only for local scripts that drive
# Browserbase directly (saving the login Context, opening Live View).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Created once, then reused forever — this is the saved logged-in
# browser profile (cookies, localStorage, IndexedDB).
# A saved Chromium profile (cookies/localStorage). Seeded by hand with
#   uv run python -m ops.browser_login
# so the worker's browser is signed in without this system ever holding a
# password. `browse` cannot attach a Context itself -- ops/bootstrap/sandbox/
# bb_connect.sh.tmpl makes the session and browse joins it over --cdp.
BROWSERBASE_CONTEXT_ID=


# ── Linear ───────────────────────────────────────────────────
# Two separate Linear personal API keys, one per tier -- independent
# revocation, and Linear's own activity log shows which tier made a
# given change. Both are full read+write, no approval prompts.
#
# Read by shot_voice.tools as the RAW Authorization header (NOT "Bearer
# <key>", which is a 401 that reads like a bad key) against
# api.linear.app/graphql -- check_my_day plus the three ticket tools.
# Leave it UNSET and check_my_day quietly answers background tasks only.
#
# It used to be a bearer header against the Linear MCP server instead. That
# came off tier 1: 65 tools and 78KB of schema, which the realtime API
# re-charges against a 40,000 TPM ceiling on every single response.
LINEAR_API_KEY_VOICE=
#
# NOT read by the worker at runtime. ops.bootstrap.anthropic_res pushes
# this into the Anthropic vault once, as a static_bearer credential keyed
# by the Linear MCP server URL -- same pattern as the Browserbase note
# above, except this one is actually wired up rather than aspirational.
LINEAR_API_KEY_WORKER=


# ── Inline tools ─────────────────────────────────────────────
# Brave is the only search API fast enough to stay inside a
# conversational turn (~669 ms p95). Anything slower gets delegated.
BRAVE_API_KEY=


# ── Policy ───────────────────────────────────────────────────
# off | callbacks_only | always -- INBOUND ONLY.
# An OUTBOUND call always asks for the PIN, under every value here:
# you dialed a number and *something* answered, and caller ID proves
# nothing about who picked up. `off` and `callbacks_only` are
# therefore identical today; `off` stays legal only so a stale value
# cannot fail validation and take the phone number down.
PIN_POLICY=callbacks_only

# 4 digits. Weakening PIN_POLICY or changing this should be an
# out-of-band action (console/CLI), never a voice command.
# TODO: move to a hash in Postgres once the supervisor exists.
CALLBACK_PIN=

# The AMD gate is NOT toggleable and deliberately has no env var.
# A positively-detected machine never hears anything about the work,
# regardless of PIN_POLICY -- so turning the PIN off for a demo can't
# make the agent read your order history to voicemail. (It does hear
# the generic greeting, which names nothing: AMD is not infallible and
# a misclassified person must get words, not a dropped line.)
